{
  "expo": {
    "name": "ALÔ ID",
    "slug": "aloid",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aloid",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aloid.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.aloid.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#04101D"
      },
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
